---
// The one shared page shell: <head>, header, footer and the scripts every page
// needs. Edit the nav or footer here and every page updates.
//
// Scripts use is:inline so Astro leaves them as plain <script src> tags pointing
// at files in public/js (the CSP only allows scripts from this domain, not inline code).
interface Props {
  title: string;
  description: string;
  current?: 'portfolio' | 'journal' | 'contact';
}
const { title, description, current } = Astro.props;
const nav = [
  { key: 'portfolio', href: '/index.html', text: 'Portfolio' },
  { key: 'journal', href: '/journal.html', text: 'Journal' },
  { key: 'contact', href: '/contact.html', text: 'Contact' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="referrer" content="no-referrer">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/style.css">
<script is:inline src="/js/boot.js"></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <a class="logo" href="/">Ansaff Ashraff</a>
  <nav class="primary-nav" aria-label="Primary">
    {nav.map((n) => (
      <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.text}</a>
    ))}
  </nav>
  <div class="header-controls">
    <div class="text-size-group" role="group" aria-label="Text size">
      <button class="ctl" data-text-dec aria-label="Decrease text size">A&minus;</button>
      <button class="ctl" data-text-reset aria-label="Reset text size">A</button>
      <button class="ctl" data-text-inc aria-label="Increase text size">A+</button>
    </div>
    <button class="ctl" data-theme-toggle aria-pressed="false" aria-label="Switch to dark mode">
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</header>

<slot name="subheader" />

<main id="main">
  <slot />
</main>

<footer class="site-footer">
  <div>Ansaff Ashraff &middot; London</div>
  <a href="/contact.html" data-mail data-user="hello" data-domain="youknowans.com" data-subject="Hello from your site">Email</a>
  <div>All photographs &copy; Ansaff Ashraff</div>
</footer>

<script is:inline src="/js/theme.js"></script>
<script is:inline src="/js/motion.js"></script>
<script is:inline src="/js/textsize.js"></script>
<script is:inline src="/js/mail.js"></script>
<slot name="scripts" />
</body>
</html>
