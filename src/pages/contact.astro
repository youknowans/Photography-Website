---
import Base from '../layouts/Base.astro';
import { socials } from '../lib/socials';
---
<Base title="About and Contact | Ansaff Ashraff"
      description="About Ansaff Ashraff and how to get in touch."
      current="contact">
  <div class="about-contact">
    <!-- Your portrait. To change it, swap the filename below (see MANUAL.md, "Your portrait").
         The address always starts with /images/thumb/, never images/full. -->
    <div class="portrait">
      <img src="/images/thumb/scotland-1.webp" alt="Portrait of Ansaff Ashraff">
    </div>
    <div class="about-text">
      <div class="bio">
        <h1>About</h1>
        <p>I'm Ansaff Ashraff. A life spent moving around the world has given me more than one way of looking at things, and travel is still at the centre of it.</p>
        <p>Whether it's people or natural landscapes, there is always something exciting about the unknown and the unfamiliar. My work is an attempt to capture that feeling in my own style.</p>
        <p>I'm always open to new projects, and I look forward to working with future clients.</p>
      </div>
      <div class="contact-block">
        <h2>Get in touch</h2>
        <p>For prints, collaborations, or just to say hello, email is the fastest way to reach me.</p>
        <a class="btn" href="/contact.html" data-mail data-user="hello" data-domain="youknowans.com" data-subject="Hello from your site">Email me</a>
        {socials.length > 0 && (
          <ul class="social-list" aria-label="Social media">
            {socials.map((s) => (
              <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</Base>
