---
import Base from '../layouts/Base.astro';
import { socials } from '../lib/socials';
---
<Base title="About and Contact | Ansaff Ashraff"
      description="About Ansaff Ashraff and how to get in touch."
      current="contact">
  <div class="about-contact">
    <!-- Your portrait. To change it, swap the filename below (see MANUAL.md, "Your portrait").
         The address always starts with /images/thumb/, never images/full. -->
    <div class="portrait">
      <img src="/images/thumb/seattle-ans-edits-26.webp" alt="Portrait of Ansaff Ashraff">
    </div>
    <div class="about-text">
      <div class="bio">
        <h1>About</h1>
        <p>I'm a geotechnical engineer based in London, and photography is the other half of how I look at places: landscapes and street scenes shot across Scotland, Spain, Germany and England, usually graded toward a colder, cinematic read.</p>
        <p>I shoot for the same reason I got into engineering. I like understanding how a place actually holds together, and photographing it is a different way of paying that same attention.</p>
      </div>
      <div class="contact-block">
        <h2>Get in touch</h2>
        <p>For prints, collaborations, or just to say hello, email is the fastest way to reach me.</p>
        <a class="btn" href="/contact.html" data-mail data-user="hello" data-domain="youknowans.com" data-subject="Hello from your site">Email me</a>
        {socials.length > 0 && (
          <ul class="social-list" aria-label="Social media">
            {socials.map((s) => (
              <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</Base>
